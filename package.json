{
  "name": "architecture-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Architecture portfolio — static site with Tailwind CSS",
  "scripts": {
    "build": "npm run build:html && npm run build:css",
    "build:html": "node ./scripts/build-html.js",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --minify",
    "watch:css": "tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
